# Data: only the directory skeleton is tracked.
# The leading slash anchors these to the repo root so src/pdeeg/data/ is NOT ignored.
/data/*
!/data/raw/
!/data/interim/
!/data/processed/
/data/raw/*
/data/interim/*
/data/processed/*
!/data/*/.gitkeep

